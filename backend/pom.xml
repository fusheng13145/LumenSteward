<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父 POM：锁定 Spring Boot 3.3.4 统一依赖版本（对齐架构设计 2.1） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.lumensteward</groupId>
    <artifactId>clawbot-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>clawbot-backend</name>
    <description>衔光管家（LumenSteward）微信 Claw 助手 · 后端分层单体</description>

    <properties>
        <!-- 目标字节码版本 17：与 SRS DC-01（Spring Boot 3.x / JDK 17+）一致；
             本机可用更高版本 JDK（如 21）编译，只要 release/target 为 17 即可 -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 第三方库版本（对齐架构设计 2.1 依赖清单） -->
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <mysql-connector.version>8.4.0</mysql-connector.version>
        <flyway.version>10.17.0</flyway.version>
        <redisson.version>3.32.0</redisson.version>
        <jjwt.version>0.12.6</jjwt.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <springdoc.version>2.6.0</springdoc.version>
        <logstash-encoder.version>7.4</logstash-encoder.version>
        <caffeine.version>3.1.8</caffeine.version>
        <lombok.version>1.18.34</lombok.version>
        <spotbugs-annotations.version>4.8.6</spotbugs-annotations.version>
        <jacoco.version>0.8.12</jacoco.version>
        <checkstyle-plugin.version>3.5.0</checkstyle-plugin.version>
        <checkstyle.version>10.18.1</checkstyle.version>
        <spotbugs-plugin.version>4.8.6.0</spotbugs-plugin.version>
        <testcontainers.version>1.20.4</testcontainers.version>
        <dependency-check.version>10.0.4</dependency-check.version>

        <!-- 单测默认排除 @Tag("integration")（依赖 Docker/Testcontainers，无 Docker 时不静默通过）。
             需要实跑集成用例（含 D7 真实 MySQL 实证）时：覆盖本属性并显式指定分组，例如
             `mvn -B -f backend/pom.xml test -Dexcluded.groups=none -Dgroups=integration`。 -->
        <excluded.groups>integration</excluded.groups>
    </properties>

    <dependencies>
        <!-- ===== Web / 校验 / 安全 / 缓存 / 可观测（启用） ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 指标注册表：使 /actuator/prometheus 具备真实引用点（FR-21 / NFR-RE-07，G-32） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== 持久化：MyBatis-Plus + MySQL + Flyway（启用） ===== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- ===== 分布式锁 / JWT / 熔断 / 文档 / 结构化日志 / 本地缓存（启用） ===== -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>${redisson.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-encoder.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>

        <!-- ===== 样板代码（启用，仅编译期） ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ===== SpotBugs 注解（编译期，配合静态检查门禁 T1） ===== -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>${spotbugs-annotations.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ===== 测试（启用） ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- =====================================================================
             以下依赖在架构设计 2.1 中标注为「预留未启用」（G-32/G-33），
             MVP 不引用，故以注释形式登记，避免误认为已实现：
             - net.javacrumbs.shedlock:shedlock-spring        (定时任务分布式锁，迭代 3)
             - org.springframework.boot:spring-boot-starter-amqp (RabbitMQ 长任务解耦)
             - org.springframework.boot:spring-boot-starter-webflux (SSE 实时通道，迭代 3)
             - com.h2database:h2                              (内嵌开发/测试库)
             ===================================================================== -->
    </dependencies>

    <build>
        <finalName>clawbot-backend</finalName>
        <plugins>
            <!-- Spring Boot 打包插件：排除 lombok（仅编译期） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- 单测运行：强制 UTF-8，避免中文断言在 GBK 控制台下乱码；
                 排除 @Tag("integration") 用例（依赖 Testcontainers/真实 MySQL，本地无 Docker 时
                 不静默通过，而是显式排除；CI 中由单独步骤以 -Dgroups=integration 运行） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{jacocoArgLine} 承接 JaCoCo 代理（T1 覆盖率采集），其后追加 UTF-8 避免中文断言乱码 -->
                    <argLine>@{jacocoArgLine} -Dfile.encoding=UTF-8</argLine>
                    <!-- 默认排除集成分组；CI 与本地常规构建用默认值，集成实跑见上方 excluded.groups 说明 -->
                    <excludedGroups>${excluded.groups}</excludedGroups>
                </configuration>
            </plugin>

            <!-- 依赖收敛 / 环境约束（NFR-MA-09：可自动化检查的规范） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.8,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 依赖漏洞扫描（AC-F2 / NFR-SE-10）：不绑定默认生命周期，
                 由 CI 作业显式调用 `mvn org.owasp:dependency-check-maven:check`，
                 避免拖慢本地日常构建 -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <skipTestScope>false</skipTestScope>
                </configuration>
            </plugin>

            <!-- ===== 迭代 2 新增包质量门禁（T1 / AC-F2 / NFR-MA-09） =====
                 仅针对迭代 2 新增/改造的包：行覆盖率 ≥ 0.70、分支覆盖率 ≥ 0.60。
                 门禁在 verify 阶段强制（haltOnFailure）；Checkstyle / SpotBugs 同范围
                 报告级接入，failOnViolation / failOnError 暂置 false（见下方说明），
                 待 S 波对存量代码统一清理后收紧为失败阻断。 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- 使用独立属性名，避免与 Surefire 内置 argLine 解析冲突（否则代理不挂载、jacoco.exec 缺失） -->
                            <propertyName>jacocoArgLine</propertyName>
                            <!-- destFile 指向 ASCII 临时目录：项目路径含中文时 JaCoCo 代理无法静默创建文件，
                                 导致 jacoco.exec 缺失、覆盖率门禁被跳过；临时目录无中文，保证落盘 -->
                            <destFile>${java.io.tmpdir}/clawbot-jacoco.exec</destFile>
                            <!-- 代理不限制 includes：对全量类插桩，保证执行数据一定采集；
                                 覆盖率门禁的范围（仅迭代2新增包）由下方 report/check 的 includes 控制 -->
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${java.io.tmpdir}/clawbot-jacoco.exec</dataFile>
                            <includes>
                                <include>com/lumensteward/clawbot/domain/port/**</include>
                                <include>com/lumensteward/clawbot/domain/tool/impl/RecognizeImageTool</include>
                                <include>com/lumensteward/clawbot/domain/tool/impl/QueryExpressTool</include>
                                <include>com/lumensteward/clawbot/domain/tool/impl/PlanRouteTool</include>
                                <include>com/lumensteward/clawbot/domain/tool/impl/SynthesizeVoiceTool</include>
                                <include>com/lumensteward/clawbot/infrastructure/media/MediaTranscodeService</include>
                                <include>com/lumensteward/clawbot/infrastructure/client/LlmVisionAdapter</include>
                                <include>com/lumensteward/clawbot/infrastructure/client/WechatMediaDispatchAdapter</include>
                                <include>com/lumensteward/clawbot/application/safety/ActionClaimExtractor</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <dataFile>${java.io.tmpdir}/clawbot-jacoco.exec</dataFile>
                            <includes>
                                <include>com/lumensteward/clawbot/domain/port/**</include>
                                <include>com/lumensteward/clawbot/domain/tool/impl/RecognizeImageTool</include>
                                <include>com/lumensteward/clawbot/domain/tool/impl/QueryExpressTool</include>
                                <include>com/lumensteward/clawbot/domain/tool/impl/PlanRouteTool</include>
                                <include>com/lumensteward/clawbot/domain/tool/impl/SynthesizeVoiceTool</include>
                                <include>com/lumensteward/clawbot/infrastructure/media/MediaTranscodeService</include>
                                <include>com/lumensteward/clawbot/infrastructure/client/LlmVisionAdapter</include>
                                <include>com/lumensteward/clawbot/infrastructure/client/WechatMediaDispatchAdapter</include>
                                <include>com/lumensteward/clawbot/application/safety/ActionClaimExtractor</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Checkstyle：迭代 2 新增包，失败阻断（failOnViolation=true，对齐 NFR-MA-09 / T1 目标；
                 实测新包 0 违例，收紧不破坏绿构建） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <failOnViolation>true</failOnViolation>
                    <consoleOutput>true</consoleOutput>
                    <includes>**/domain/port/**/*.java,**/domain/tool/impl/RecognizeImageTool.java,**/domain/tool/impl/QueryExpressTool.java,**/domain/tool/impl/PlanRouteTool.java,**/domain/tool/impl/SynthesizeVoiceTool.java,**/infrastructure/media/MediaTranscodeService.java,**/infrastructure/client/LlmVisionAdapter.java,**/infrastructure/client/WechatMediaDispatchAdapter.java,**/application/safety/ActionClaimExtractor.java</includes>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- SpotBugs：迭代 2 新增包，失败阻断（绑定 check 目标 + failOnError=true，对齐 NFR-MA-09 / T1；
                 实测新包 0 bug（threshold=High），收紧不破坏绿构建） -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-plugin.version}</version>
                <configuration>
                    <onlyAnalyze>com.lumensteward.clawbot.domain.port.*,com.lumensteward.clawbot.domain.tool.impl.RecognizeImageTool,com.lumensteward.clawbot.domain.tool.impl.QueryExpressTool,com.lumensteward.clawbot.domain.tool.impl.PlanRouteTool,com.lumensteward.clawbot.domain.tool.impl.SynthesizeVoiceTool,com.lumensteward.clawbot.infrastructure.media.MediaTranscodeService,com.lumensteward.clawbot.infrastructure.client.LlmVisionAdapter,com.lumensteward.clawbot.infrastructure.client.WechatMediaDispatchAdapter,com.lumensteward.clawbot.application.safety.ActionClaimExtractor</onlyAnalyze>
                    <failOnError>true</failOnError>
                    <threshold>High</threshold>
                    <effort>Max</effort>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
