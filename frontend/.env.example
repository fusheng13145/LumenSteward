# ============================================================================
# 前端环境变量「配置契约」（随仓库提交，G-30 / B29）
# 复制为 .env.local 并填入真实值；.env.local / .env 已被 .gitignore 忽略。
# 所有变量统一 VITE_ 前缀（NFR-MA-06）；禁止在此提交任何真实密钥。
# ============================================================================

# 应用标题（显示于浏览器标签与布局头部）
VITE_APP_TITLE=衔光管家

# 后端 API 基础路径（前端所有请求以此为前缀；生产由 Nginx 反向代理 /api）
VITE_API_BASE_URL=/api

# 本地开发服务器代理目标（仅 dev 生效；生产不使用）
VITE_API_PROXY_TARGET=http://localhost:8080
