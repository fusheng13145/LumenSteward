{
  "name": "clawbot-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "衔光管家（LumenSteward）微信 Claw 助手 · 管理后台（Vue 3 + TS + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
