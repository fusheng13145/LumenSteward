%% Claw 助手（LumenSteward）MVP 类图（Class Diagram）
%% 来源：docs/MVP架构设计与任务分解.md 第 3、5 章
%% 包名基址：com.lumensteward.clawbot

classDiagram
    direction TB

    %% ========== 工具契约（domain.tool，FR-23 / 9.4.2） ==========
    class Tool {
        <<interface>>
        +name() String
        +description() String
        +parametersSchema() JsonSchema
        +execute(ToolContext, JsonNode) ToolResult
        +idempotent() boolean
        +critical() boolean
    }
    class ToolContext {
        <<record>>
        +String traceId
        +String openid
        +Long sessionId
        +int llmRound
        +Map~String,Object~ attributes
    }
    class ToolResult {
        <<record>>
        +ToolStatus status
        +String errorType
        +String message
        +JsonNode data
        +boolean retryable
        +long latencyMs
        +success(JsonNode,long) ToolResult
        +failure(String,String,boolean) ToolResult
        +timeout(String) ToolResult
    }
    class ToolStatus {
        <<enum>>
        SUCCESS
        FAILED
        DEGRADED
        TIMEOUT
        NOT_EXECUTED
    }
    class JsonSchema {
        +validate(JsonNode) ValidationResult
        +node() JsonNode
        +of(String) JsonSchema
    }
    class ToolRegistry {
        -Map~String,Tool~ tools
        +ToolRegistry(List~Tool~)
        +find(String) Optional~Tool~
        +names() Set~String~
        +enabledSchemas(Set~String~) List~JsonNode~
        -validate(Tool) void
    }
    class ManagePetProfileTool {
        +name() String
        +idempotent() boolean
        +critical() boolean
        +execute(ToolContext, JsonNode) ToolResult
    }

    Tool <|.. ManagePetProfileTool
    ToolRegistry o-- Tool : registers
    Tool ..> ToolResult : returns
    Tool ..> JsonSchema : declares
    Tool ..> ToolContext : uses
    ToolResult --> ToolStatus

    %% ========== 宠物档案领域（FR-14 / 3.3 唯一约束） ==========
    class PetProfileService {
        <<interface>>
        +create(String, PetProfileCommand) PetProfileView
        +listLive(String) List~PetProfileView~
        +findLiveByName(String, String) Optional~PetProfileView~
        +update(String, String, PetProfilePatch) PetProfileView
        +softDelete(String, String) void
    }
    class PetProfileServiceImpl
    class PetProfileView {
        <<record>>
        +Long id
        +String openid
        +String petName
        +String petType
        +String breed
        +String gender
        +LocalDate birthday
        +BigDecimal weightKg
    }
    class PetProfileCommand {
        <<record>>
        +String petName
        +String petType
        +String breed
        +String gender
        +LocalDate birthday
    }

    ManagePetProfileTool ..> PetProfileService : delegates
    PetProfileService <|.. PetProfileServiceImpl
    PetProfileService ..> PetProfileView : returns
    PetProfileService ..> PetProfileCommand : accepts

    %% ========== LLM 网关抽象（9.4.1 / 8.4） ==========
    class LlmClient {
        <<interface>>
        +chat(ChatRequest) ChatResult
        +vision(VisionRequest) VisionResult
        +provider() String
    }
    class MockLlmClient
    class OpenAiCompatibleLlmClient
    class ChatRequest {
        <<record>>
        +String model
        +List~ChatMessage~ messages
        +List~JsonNode~ tools
        +String toolChoice
        +boolean stream
        +Duration timeout
    }
    class ChatMessage {
        <<record>>
        +String role
        +String content
        +String toolCallId
        +List~ToolCall~ toolCalls
    }
    class ToolCall {
        <<record>>
        +String id
        +String type
        +String functionName
        +String argumentsJson
    }
    class ChatResult {
        <<record>>
        +String content
        +List~ToolCall~ toolCalls
        +TokenUsage usage
        +String finishReason
    }
    class LlmException {
        <<abstract>>
        +errorType() String
    }

    LlmClient <|.. MockLlmClient
    LlmClient <|.. OpenAiCompatibleLlmClient
    LlmClient ..> ChatRequest : accepts
    LlmClient ..> ChatResult : returns
    ChatRequest o-- ChatMessage
    ChatMessage o-- ToolCall
    MockLlmClient ..> LlmException : throws
    OpenAiCompatibleLlmClient ..> LlmException : throws

    %% ========== 微信通道（9.4.6） ==========
    class WechatTransport {
        <<interface>>
        +transportMode() String
        +sendCustomerMessage(String, CustomerMessage) SendResult
        +uploadTempMedia(byte[], String, String) MediaId
        +downloadMedia(String) byte[]
    }
    class MockWechatTransport
    class RealWechatTransport
    class WechatSignatureVerifier {
        <<interface>>
        +verify(String, String, String, String) void
    }
    class WechatMessageParser {
        <<interface>>
        +parse(String, String) InternalMessage
    }
    class InternalMessage {
        <<record>>
        +String openid
        +String msgType
        +String msgId
        +String content
        +String mediaId
        +long createTime
    }
    class WechatTokenService {
        <<interface>>
        +getAccessToken() String
        +evictAndRefresh() void
    }

    WechatTransport <|.. MockWechatTransport
    WechatTransport <|.. RealWechatTransport
    WechatMessageParser ..> InternalMessage : produces
    WechatCallbackController ..> WechatSignatureVerifier : uses
    WechatCallbackController ..> WechatMessageParser : uses
    WechatCallbackController ..> DedupService : uses

    %% ========== 接入层（FR-01/02/03） ==========
    class WechatCallbackController {
        +verifyEcho(String, String, String, String) String
        +receive(String, String, String, String, String) String
    }
    class MessageDispatcher {
        +dispatch(InternalMessage) void
    }
    class MessageHandler {
        <<interface>>
        +supportsMsgType() String
        +handle(InternalMessage) void
    }
    class DedupService {
        <<interface>>
        +markIfAbsent(String) boolean
    }
    class WechatMessageService {
        +handleInboundWithReceipt(InternalMessage, String) String
        +pushAsync(String, String) void
    }

    WechatCallbackController ..> MessageDispatcher : delegates
    MessageDispatcher o-- MessageHandler : strategies
    MessageHandler ..> WechatMessageService : delivers

    %% ========== 应用层编排（FR-07 / 9.4.3） ==========
    class AgentOrchestrator {
        <<interface>>
        +run(OrchestrationRequest) OrchestrationResult
    }
    class AgentOrchestratorImpl
    class OrchestrationRequest {
        <<record>>
        +String traceId
        +String openid
        +Long sessionId
        +String userMessage
        +List~ChatMessage~ history
    }
    class OrchestrationResult {
        <<record>>
        +String replyText
        +SessionState finalState
        +List~ToolCallRecord~ executedTools
        +String fallbackReason
        +int llmCalls
        +int rounds
    }
    class ToolCallRecord {
        <<record>>
        +String toolName
        +int callSeq
        +int llmRound
        +ToolStatus status
        +String fallbackReason
        +long latencyMs
    }

    AgentOrchestrator <|.. AgentOrchestratorImpl
    AgentOrchestrator ..> OrchestrationRequest : accepts
    AgentOrchestrator ..> OrchestrationResult : returns
    OrchestrationResult o-- ToolCallRecord

    %% ========== 上下文（FR-04 / 9.4.4） ==========
    class ContextStore {
        <<interface>>
        +load(String) List~ChatMessage~
        +append(String, ChatMessage) void
        +clear(String) void
        +isAvailable() boolean
    }
    class RedisContextStore
    class ContextTrimmer {
        +trim(List~ChatMessage~, int, int) List~ChatMessage~
    }
    class TokenEstimator {
        <<interface>>
        +estimate(String) int
    }

    ContextStore <|.. RedisContextStore
    AgentOrchestratorImpl ..> ContextStore : loads
    AgentOrchestratorImpl ..> ContextTrimmer : trims
    ContextTrimmer ..> TokenEstimator : uses

    %% ========== 输出治理（FR-09 / 9.4.5） ==========
    class ContentSafetyService {
        <<interface>>
        +review(String) SafetyVerdict
    }
    class ConsistencyChecker {
        <<interface>>
        +check(String, List~ToolCallRecord~) ConsistencyVerdict
    }
    class RuleBasedConsistencyChecker
    class ActionClaimExtractor {
        +extract(String) List~ActionClaim~
    }
    class ConsistencyVerdict {
        <<record>>
        +boolean passed
        +String claimText
        +ConsistencyReason reason
    }
    class ConsistencyReason {
        <<enum>>
        PASSED
        CLAIM_UNSUPPORTED
        VALUE_NOT_TRACEABLE
    }
    class FallbackService {
        <<interface>>
        +render(FallbackReason, Map~String,Object~) String
    }

    ConsistencyChecker <|.. RuleBasedConsistencyChecker
    RuleBasedConsistencyChecker ..> ActionClaimExtractor : uses
    RuleBasedConsistencyChecker ..> ConsistencyVerdict : returns
    ConsistencyVerdict --> ConsistencyReason
    AgentOrchestratorImpl ..> ConsistencyChecker : verifies
    AgentOrchestratorImpl ..> ContentSafetyService : reviews
    AgentOrchestratorImpl ..> FallbackService : degrades

    %% ========== 意图（FR-05） ==========
    class IntentClassifier {
        <<interface>>
        +classify(List~ChatMessage~, String) IntentResult
    }
    class IntentType {
        <<enum>>
        PET_PROFILE
        EXPRESS
        NAVIGATION
        TTS
        IMAGE
        CHITCHAT
        UNKNOWN
    }
    IntentClassifier ..> IntentType : yields

    %% ========== 自检与引导（SUP-05/06, Q7） ==========
    class StartupDoctor {
        <<interface>>
        +diagnose() DoctorReport
    }
    class DoctorReport {
        <<record>>
        +String overall
        +Instant checkedAt
        +List~DependencyCheck~ items
    }
    class DependencyCheck {
        <<record>>
        +String name
        +String connectivity
        +String mode
        +String configConclusion
    }
    class PlaceholderConfigValidator {
        +run(ApplicationArguments) void
    }
    class AdminBootstrapRunner {
        +run(ApplicationArguments) void
    }

    StartupDoctor ..> DoctorReport : returns
    DoctorReport o-- DependencyCheck
    DoctorController ..> StartupDoctor : invokes

    class DoctorController {
        +diagnose() ApiResponse~DoctorReport~
    }
    class AuthService {
        <<interface>>
        +login(LoginRequest) LoginResponse
        +logout(String) void
    }
    class JwtTokenProvider {
        +generate(SysAdminUser) String
        +parse(String) Claims
    }

    %% ========== 数据模型（MyBatis-Plus 实体） ==========
    class WxUserEntity {
        +Long id
        +String openid
        +String nickname
        +Integer status
        +LocalDateTime lastInteractAt
        +LocalDateTime createdAt
        +LocalDateTime updatedAt
        +LocalDateTime deletedAt
    }
    class WxSessionEntity {
        +Long id
        +String openid
        +String contextKey
        +String state
        +Integer turnCount
    }
    class WxMessageEntity {
        +Long id
        +Long sessionId
        +String openid
        +String msgId
        +String role
        +String msgType
        +String content
        +Integer sendStatus
    }
    class PetProfileEntity {
        +Long id
        +String openid
        +String petName
        +String petType
        +LocalDate birthday
        +LocalDateTime deletedAt
    }
    class ToolCallLogEntity {
        +Long id
        +String traceId
        +String openid
        +Long sessionId
        +String toolName
        +Integer callSeq
        +Integer status
        +String fallbackReason
        +Integer latencyMs
    }
    class SysAdminUserEntity {
        +Long id
        +String username
        +String passwordHash
        +String role
        +Integer failCount
        +LocalDateTime lockedUntil
    }
    class SysConfigEntity {
        +Long id
        +String configKey
        +String configValue
        +String valueType
        +Integer isEncrypted
    }
    class AuditLogEntity {
        +Long id
        +Long adminId
        +String regType
        +String action
        +String beforeValue
        +String afterValue
        +Integer result
    }

    WxUserEntity "1" --> "0..*" WxSessionEntity : owns
    WxUserEntity "1" --> "0..*" PetProfileEntity : registers
    WxSessionEntity "1" --> "0..*" WxMessageEntity : contains
    WxUserEntity "1" --> "0..*" ToolCallLogEntity : triggers
    WxSessionEntity "1" --> "0..*" ToolCallLogEntity : scopes
    SysAdminUserEntity "1" --> "0..*" AuditLogEntity : produces

    PetProfileServiceImpl ..> PetProfileEntity : persists
    ToolCallLogServiceImpl ..> ToolCallLogEntity : persists
    AuditLogServiceImpl ..> AuditLogEntity : persists
    WxMessageRepositoryImpl ..> WxMessageEntity : persists
