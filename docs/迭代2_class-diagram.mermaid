%% 迭代 2 类图（相对 MVP 的"新增/变更"部分）
%% 基址：com.lumensteward.clawbot
%% 溯源：SRS FR-06/09/10/11/12/13/14/16/18、A-2、B-2、NFR-MA-03/04/09

classDiagram
    direction TB

    %% ========== 领域端口（上提自 infrastructure/client，SRS 9.2/1.1） ==========
    class VisionPort {
        <<interface>>
        +vision(VisionRequest) VisionResult
    }
    class VoiceSynthesisPort {
        <<interface>>
        +synthesize(String, String) byte[]
    }
    class ExpressQueryPort {
        <<interface>>
        +query(String, String) ExpressTrace
    }
    class MapNavigationPort {
        <<interface>>
        +geocode(String) GeoPoint
        +planRoute(GeoPoint, GeoPoint, RouteMode) RouteResult
    }
    class MediaDispatchPort {
        <<interface>>
        +sendVoice(String, byte[], String) MediaId
    }

    %% ========== 端口 DTO（上移，domain/port/model） ==========
    class VisionRequest { String model; String imageUrlOrBase64; String question }
    class VisionResult { boolean success; String text; double confidence }
    class ExpressTrace { String companyCode; String trackingNo; String state; boolean found; List~Node~ nodes }
    class GeoPoint { double longitude; double latitude; String label }
    class RouteResult { double distanceMeters; long durationSeconds; RouteMode mode; String summary }
    class RouteMode { <<enum>> DRIVING WALKING TRANSIT }

    VisionPort ..> VisionRequest : accepts
    VisionPort ..> VisionResult : returns
    ExpressQueryPort ..> ExpressTrace : returns
    MapNavigationPort ..> GeoPoint : uses
    MapNavigationPort ..> RouteResult : returns

    %% ========== 4 个新业务工具（domain/tool/impl，均 @Component Tool） ==========
    class RecognizeImageTool {
        +name() String
        +idempotent() boolean
        +critical() boolean
        +execute(ToolContext, JsonNode) ToolResult
    }
    class SynthesizeVoiceTool {
        +name() String
        +idempotent() boolean
        +critical() boolean
        +execute(ToolContext, JsonNode) ToolResult
    }
    class QueryExpressTool {
        +name() String
        +idempotent() boolean
        +critical() boolean
        +execute(ToolContext, JsonNode) ToolResult
    }
    class PlanRouteTool {
        +name() String
        +idempotent() boolean
        +critical() boolean
        +execute(ToolContext, JsonNode) ToolResult
    }

    RecognizeImageTool ..|> Tool : implements
    SynthesizeVoiceTool ..|> Tool : implements
    QueryExpressTool ..|> Tool : implements
    PlanRouteTool ..|> Tool : implements

    RecognizeImageTool ..> VisionPort : uses
    RecognizeImageTool ..> PetProfileService : 品种反查档案名
    SynthesizeVoiceTool ..> VoiceSynthesisPort : uses
    SynthesizeVoiceTool ..> MediaDispatchPort : 下发语音
    QueryExpressTool ..> ExpressQueryPort : uses
    PlanRouteTool ..> MapNavigationPort : uses
    PlanRouteTool ..> GeoPoint : 临时使用不落库

    %% ========== 应用层（FR-18/B-2/FR-16/A-2/FR-09 变更） ==========
    class DynamicConfigService {
        <<interface>>
        +getString(String, String) String
        +getInt(String, int) int
        +getBool(String, boolean) boolean
        +set(String, String) void
    }
    class ConfigAdminService {
        +update(ConfigUpdateRequest) ConfigVO
    }
    class UserAdminService {
        +disable(Long, boolean) void
    }
    class UserStatusGate {
        +isEnabled(String) boolean
    }
    class AuditLogService {
        +write(RegType, String, String, String) void
    }
    class ReplayService {
        +replay(ReplayRequest) ReplayResult
    }

    AgentOrchestratorImpl ..> DynamicConfigService : 读 disabled-tools/llm.model
    ConfigAdminService ..> DynamicConfigService : 写 sys_config
    ConfigAdminService ..> AuditLogService : 变更留痕
    UserAdminService ..> AuditLogService : 前后值留痕
    UserAdminService ..> UserStatusGate : 禁用状态
    WechatMessageService ..> UserStatusGate : 禁用不触发 LLM

    %% ========== 基础设施（实现领域端口；infra->domain 合法） ==========
    class LlmVisionAdapter
    class WechatMediaDispatchAdapter
    class LlmClientRouter
    class MockLogisticsClient
    class MockMapClient
    class MockTtsClient
    class RealLogisticsClient
    class RealMapClient
    class RealTtsClient
    class MediaTranscodeService

    VisionPort <|.. LlmVisionAdapter
    MediaDispatchPort <|.. WechatMediaDispatchAdapter
    ExpressQueryPort <|.. MockLogisticsClient
    ExpressQueryPort <|.. RealLogisticsClient
    MapNavigationPort <|.. MockMapClient
    MapNavigationPort <|.. RealMapClient
    VoiceSynthesisPort <|.. MockTtsClient
    VoiceSynthesisPort <|.. RealTtsClient
    LlmClient <|.. LlmClientRouter
    LlmVisionAdapter ..> LlmClient : 委托 vision
    WechatMediaDispatchAdapter ..> WechatTransport : uploadTempMedia/send
    SynthesizeVoiceTool ..> MediaTranscodeService : ffmpeg 转码
    LlmClientRouter ..> DynamicConfigService : 选 provider

    %% ========== FR-09 一致性（MVP 已具备，迭代 2 补动词） ==========
    class ActionClaimExtractor {
        +extract(String) List~ActionClaim~
        +toolSemantics(String) Set~String~
    }
    class RuleBasedConsistencyChecker
    ActionClaimExtractor ..> Tool : 语义映射(recognize_image/synthesize_voice/query_express/plan_route/manage_pet_profile)
    RuleBasedConsistencyChecker ..> ActionClaimExtractor : uses

    %% ========== 回放（A-2，复用 log_tool_call） ==========
    class ToolLogController
    ToolLogController ..> ReplayService : replay
    ReplayService ..> ToolRegistry : 重新调用工具
    ReplayService ..> RuleBasedConsistencyChecker : 复现拦截
