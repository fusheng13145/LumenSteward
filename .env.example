# ============================================================================
# 后端环境变量「配置契约」（随仓库提交；真实 .env / .env.local 已被 .gitignore 忽略，BR-20）
# 用法：复制为 .env（Docker Compose）或 export 后启动；禁止在此提交任何真实密钥。
# ============================================================================

# ===== 数据库（MySQL 8）=====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clawbot
DB_USERNAME=root
# 本地默认口令，生产环境必须改为强口令并经密钥管理注入
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ===== 缓存（Redis 7）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 微信开放平台（BR-01，平台验签）=====
WX_TOKEN=
WX_APP_ID=
WX_APP_SECRET=
WX_ENCODING_AES_KEY=
# Mock 通道开关（SUP-01；true=Mock，false=真实，切换零代码改动）
WX_MOCK_ENABLED=true

# ===== LLM 网关（9.4.1）=====
# mock / real
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-model

# ===== 初始管理员口令注入（Q7 / BR-20，禁止硬编码）=====
ADMIN_INIT_PASSWORD=

# ===== 后端运行参数 =====
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
